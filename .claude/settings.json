{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash",
      "PowerShell",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__ccd_turn",
      "mcp__ccd_pr"
    ],
    "deny": [
      "Edit(calibration/ledger.csv)",
      "Write(calibration/ledger.csv)",
      "Edit(calibration/benchmark_ledger.csv)",
      "Write(calibration/benchmark_ledger.csv)",
      "Edit(forecasts/2026/**)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/validate-immutable.py\"",
            "timeout": 10,
            "statusMessage": "불변 경로 검사"
          }
        ]
      }
    ]
  }
}
