+        ("targeted_pytest", [sys.executable, "-m", "pytest", *targeted, "-q"]),
+        ("full_pytest", [sys.executable, "-m", "pytest", "-q"]),
+        (
+            "diff_check",
+            [
+                "git",
+                "diff",
+                "--check",
+                "HEAD",
+                "--",
