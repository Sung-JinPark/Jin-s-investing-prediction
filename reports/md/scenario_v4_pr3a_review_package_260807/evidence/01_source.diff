+    assert view["subtitle"] == "NOT RCFHS · NOT OFFICIAL · NOT CHAMPION"
+    assert view["supportsStructuralBaseline"] is False
+    assert view["supportsLookup"] is False
+    assert view["sourceStatus"] == "shadow_only"
