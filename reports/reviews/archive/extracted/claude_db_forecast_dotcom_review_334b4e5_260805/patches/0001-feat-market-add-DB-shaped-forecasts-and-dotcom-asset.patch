diff --git a/data/contracts/cross_asset_dotcom_counterfactual.yaml b/data/contracts/cross_asset_dotcom_counterfactual.yaml
new file mode 100644
index 0000000..90d7361
--- /dev/null
+++ b/data/contracts/cross_asset_dotcom_counterfactual.yaml
@@ -0,0 +1,60 @@
+schema_version: 1
+contract_version: 2026-08-05.v1
+status: preregistered
+preregistered_at: 2026-08-05
+probability_space: reference_only
+model_kind: historical_counterfactual
+
+comparison_window:
+  anchor: 2001-03
+  end: 2006-03
+  horizon_months: 60
+  observations: 61
+  anchor_definition: >-
+    The observed NASDAQ and Realty Income month closes at 2001-03 are normalized
+    to 100. This is twelve months after the NASDAQ dotcom peak month of 2000-03,
+    not a claim that every bubble bursts at the same lag.
+
+observed_assets:
+  nasdaq:
+    symbol: ^IXIC
+    basis: monthly_close
+  realty_income:
+    symbol: O
+    basis: monthly_close
+  realty_income_total_return:
+    symbol: O
+    basis: yahoo_adjusted_close_public_proxy
+
+bitcoin:
+  status: counterfactual_not_observed
+  data_gap: Bitcoin launched in 2009; no market price exists in 2001-03..2006-03.
+  formula: BTC_t = BTC_(t-1) * exp(beta_regime * NASDAQ_monthly_log_return)
+  regime_rule:
+    negative_nasdaq_month: downside_5y
+    nonnegative_nasdaq_month: full_252d
+  cases:
+    btc_low_beta:
+      downside_beta: downside_5y.bootstrap_p10
+      upside_beta: full_252d.bootstrap_p10
+    btc_regime_center:
+      downside_beta: downside_5y.measured_used
+      upside_beta: full_252d.measured_used
+    btc_high_beta:
+      downside_beta: downside_5y.bootstrap_p90
+      upside_beta: full_252d.bootstrap_p90
+    btc_full_beta:
+      downside_beta: full_252d.measured_used
+      upside_beta: full_252d.measured_used
+
+guardrails:
+  - Never label the Bitcoin series as observed or historical price.
+  - Never interpolate missing observed months.
+  - NASDAQ and Realty Income paths must be identical across every Bitcoin case.
+  - Current Realty Income rate and credit sensitivities are audit context only and cannot alter history.
+  - The beta envelope is sensitivity analysis, not a confidence interval or probability band.
+  - Do not assign scenario weights, event probabilities, expected returns, or target prices.
+
+change_policy: >-
+  Append an approved calibration/corrections.csv row and issue a new immutable
+  cross-asset snapshot revision before changing the window, cases, or formula.
diff --git a/data/contracts/scenario_structural_forecast.yaml b/data/contracts/scenario_structural_forecast.yaml
new file mode 100644
index 0000000..4ad1368
--- /dev/null
+++ b/data/contracts/scenario_structural_forecast.yaml
@@ -0,0 +1,56 @@
+version: 2026-08-05.v1
+status: preregistered_before_structural_snapshot
+preregistered_at: 2026-08-05
+scope: nasdaq_scenario_display_path
+probability_space: scenario_conditional
+change_policy: append approved calibration/corrections.csv row and issue a new version
+
+innovation_cycle:
+  source: data/ml_history/*.jsonl
+  row_kind: context
+  required_fields: [analog.selected_eras, analog.correction_depth_median, overlay.ai]
+  minimum_selected_eras: 3
+  days_per_phase_month: 30.4375
+  aggregation: cross-era median at each fractional monthly phase
+  trend_removal: geometric endpoint detrend within each displayed calendar year
+
+calibration:
+  target: origin-year S1 maximum drawdown
+  target_source: latest context analog.correction_depth_median
+  strength_bounds: [0.0, 5.0]
+  endpoint_rule: preserve every scenario year-segment start and end anchor
+  forbidden:
+    - hand-drawn correction dates
+    - random sample path as the thick display line
+    - changing fan quantiles or S1/S2/S3 weights
+
+physical_event_reference:
+  question_id: nasdaq-corr10-augoct-2026
+  window: [2026-08-01, 2026-10-31]
+  probability_space: physical_event
+  use: separate evidence box only
+  used_numerically: false
+
+reference_layers:
+  scenario_tracker:
+    source: data/signals/scenario_tracker_latest.json
+    used_numerically: false
+    reason: registered count states prohibit weighted-score or probability conversion
+  liquidity:
+    source: data/liquidity/liquidity_latest.json
+    used_numerically: false
+    reason: reference-only state does not identify path timing
+  ai_regime:
+    source: data/ai_capital_cycle/ai_regime_latest.json
+    activation_gate: coverage >= 0.6
+    below_gate_use: prohibited
+
+display:
+  default_year: 2026
+  split: calendar_year
+  exact_day_language: prohibited
+  required_labels:
+    - DB 조건부 구조 경로
+    - 월 단위 위험창
+    - 사건확률과 결합 금지
+    - 목표가나 투자자문이 아님
