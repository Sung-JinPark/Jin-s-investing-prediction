+    phase_contract = (
+        ("steady_drift", 42, .30, .65),
+        ("mean_reversion", 21, .00, .40),
+        ("normalization", 42, .35, .70),
+    )
+    pools: dict[str, tuple[np.ndarray, list[str]]] = {}
