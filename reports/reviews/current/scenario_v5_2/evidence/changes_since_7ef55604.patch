diff --git a/reports/diagnostics/v52_distinctness_baseline_20260811/CALL_GRAPH_AND_COORDINATE_AUDIT.md b/reports/diagnostics/v52_distinctness_baseline_20260811/CALL_GRAPH_AND_COORDINATE_AUDIT.md
